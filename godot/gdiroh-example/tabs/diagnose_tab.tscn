[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://tabs/diagnose_tab.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://common/copy_field.tscn" id="2_copy"]
[ext_resource type="PackedScene" path="res://common/log_panel.tscn" id="3_log"]

[node name="Diagnose" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 6
script = ExtResource("1_script")
slug = "diagnose"

[node name="Blurb" type="Label" parent="."]
layout_mode = 2
text = "When a friend cannot reach you, this endpoint knows why: its addresses, its relays, and every counter iroh keeps."
autowrap_mode = 3

[node name="Lifecycle" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Start" type="Button" parent="Lifecycle"]
layout_mode = 2
text = "Start endpoint"

[node name="Stop" type="Button" parent="Lifecycle"]
layout_mode = 2
disabled = true
text = "Stop"

[node name="Random" type="CheckBox" parent="Lifecycle"]
layout_mode = 2
tooltip_text = "start with a throwaway id — for extra copies sharing user://, like the editor's multi-instance run"
text = "Random id"

[node name="Status" type="Label" parent="Lifecycle"]
layout_mode = 2
text = "stopped"

[node name="Id" parent="." instance=ExtResource("2_copy")]
layout_mode = 2

[node name="Ticket" parent="." instance=ExtResource("2_copy")]
layout_mode = 2

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Refresh" type="Button" parent="Row"]
layout_mode = 2
disabled = true
text = "Refresh addresses"

[node name="Metrics" type="Button" parent="Row"]
layout_mode = 2
disabled = true
text = "Metrics"

[node name="Forget" type="Button" parent="Row"]
layout_mode = 2
tooltip_text = "delete this tab's saved identity; the next start gets a new id"
text = "Forget identity"

[node name="Summary" type="Label" parent="."]
layout_mode = 2
text = "stopped"

[node name="Log" parent="." instance=ExtResource("3_log")]
layout_mode = 2
size_flags_vertical = 3
