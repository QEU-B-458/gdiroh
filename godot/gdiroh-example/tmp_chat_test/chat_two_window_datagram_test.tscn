[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://tmp_chat_test/chat_two_window_datagram.gd" id="1_script"]

[node name="ChatTwoWindowDatagramTest" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 8
script = ExtResource("1_script")

[node name="Instructions" type="Label" parent="."]
layout_mode = 2
text = "same as the stream test, but woof travels as a datagram: run this scene in two separate instances. in one window, press \"copy my ticket to clipboard\". in the other, press \"join from clipboard\". watch the Output panel in both."
autowrap_mode = 3

[node name="copy_endpoint_to_clipboard" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "copy my ticket to clipboard"

[node name="join_from_clipboard" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "join from clipboard"
