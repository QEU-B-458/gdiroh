[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://tabs/movement_tab.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://common/copy_field.tscn" id="2_copy"]
[ext_resource type="PackedScene" path="res://common/log_panel.tscn" id="3_log"]

[node name="Movement" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 6
script = ExtResource("1_script")
slug = "move"

[node name="Blurb" type="Label" parent="."]
layout_mode = 2
text = "Positions over datagrams at a rate you pick. The other peer's dot moves because packets are arriving."
autowrap_mode = 3

[node name="Lifecycle" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Start" type="Button" parent="Lifecycle"]
layout_mode = 2
text = "Start endpoint"

[node name="Stop" type="Button" parent="Lifecycle"]
layout_mode = 2
disabled = true
text = "Stop"

[node name="Random" type="CheckBox" parent="Lifecycle"]
layout_mode = 2
tooltip_text = "start with a throwaway id — for extra copies sharing user://, like the editor's multi-instance run"
text = "Random id"

[node name="Status" type="Label" parent="Lifecycle"]
layout_mode = 2
text = "stopped"

[node name="Id" parent="." instance=ExtResource("2_copy")]
layout_mode = 2

[node name="Ticket" parent="." instance=ExtResource("2_copy")]
layout_mode = 2

[node name="Dial" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Target" type="LineEdit" parent="Dial"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "the other peer's ticket or id"

[node name="Connect" type="Button" parent="Dial"]
layout_mode = 2
disabled = true
text = "Link up"

[node name="Rate" type="SpinBox" parent="Dial"]
layout_mode = 2
tooltip_text = "positions sent per second"
min_value = 1.0
max_value = 60.0
value = 20.0
suffix = "/s"

[node name="Field" type="Panel" parent="."]
custom_minimum_size = Vector2(0, 180)
layout_mode = 2

[node name="Me" type="ColorRect" parent="Field"]
offset_right = 12.0
offset_bottom = 12.0
color = Color(0.35, 0.85, 0.45, 1)

[node name="Them" type="ColorRect" parent="Field"]
offset_right = 12.0
offset_bottom = 12.0
color = Color(0.9, 0.45, 0.4, 1)

[node name="Readout" type="Label" parent="."]
layout_mode = 2
text = "not linked"

[node name="Log" parent="." instance=ExtResource("3_log")]
layout_mode = 2
size_flags_vertical = 3
