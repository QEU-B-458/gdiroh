[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://tabs/session_tab.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://common/copy_field.tscn" id="2_copy"]
[ext_resource type="PackedScene" path="res://common/log_panel.tscn" id="3_log"]

[node name="Session" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 6
script = ExtResource("1_script")
slug = "session"

[node name="Blurb" type="Label" parent="."]
layout_mode = 2
text = "Godot's own multiplayer over gdiroh: host or join, and RPCs work as they do over ENet."
autowrap_mode = 3

[node name="Lifecycle" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Start" type="Button" parent="Lifecycle"]
layout_mode = 2
text = "Start endpoint"

[node name="Stop" type="Button" parent="Lifecycle"]
layout_mode = 2
disabled = true
text = "Stop"

[node name="Random" type="CheckBox" parent="Lifecycle"]
layout_mode = 2
tooltip_text = "start with a throwaway id — for extra copies sharing user://, like the editor's multi-instance run"
text = "Random id"

[node name="Status" type="Label" parent="Lifecycle"]
layout_mode = 2
text = "stopped"

[node name="Id" parent="." instance=ExtResource("2_copy")]
layout_mode = 2

[node name="Ticket" parent="." instance=ExtResource("2_copy")]
layout_mode = 2

[node name="Actions" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Host" type="Button" parent="Actions"]
layout_mode = 2
disabled = true
text = "Host"

[node name="Target" type="LineEdit" parent="Actions"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "the host's ticket or id"

[node name="Join" type="Button" parent="Actions"]
layout_mode = 2
disabled = true
text = "Join"

[node name="Say" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Message" type="LineEdit" parent="Say"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "say something over an @rpc"

[node name="Mode" type="OptionButton" parent="Say"]
layout_mode = 2
tooltip_text = "how the rpc's packets travel — a stream, or datagrams"

[node name="Send" type="Button" parent="Say"]
layout_mode = 2
disabled = true
text = "Send"

[node name="Readout" type="Label" parent="."]
layout_mode = 2
text = "no peers yet"

[node name="Log" parent="." instance=ExtResource("3_log")]
layout_mode = 2
size_flags_vertical = 3
