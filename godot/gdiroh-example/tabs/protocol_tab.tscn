[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://tabs/protocol_tab.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://common/copy_field.tscn" id="2_copy"]
[ext_resource type="PackedScene" path="res://common/log_panel.tscn" id="3_log"]

[node name="Protocol" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 6
script = ExtResource("1_script")
slug = "protocol"

[node name="Blurb" type="Label" parent="."]
layout_mode = 2
text = "A protocol of your own: agree on a name, then the bytes are yours. This one keeps one stream open and shouts every line back in capitals."
autowrap_mode = 3

[node name="Lifecycle" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Start" type="Button" parent="Lifecycle"]
layout_mode = 2
text = "Start endpoint"

[node name="Stop" type="Button" parent="Lifecycle"]
layout_mode = 2
disabled = true
text = "Stop"

[node name="Random" type="CheckBox" parent="Lifecycle"]
layout_mode = 2
tooltip_text = "start with a throwaway id — for extra copies sharing user://, like the editor's multi-instance run"
text = "Random id"

[node name="Status" type="Label" parent="Lifecycle"]
layout_mode = 2
text = "stopped"

[node name="Id" parent="." instance=ExtResource("2_copy")]
layout_mode = 2

[node name="Ticket" parent="." instance=ExtResource("2_copy")]
layout_mode = 2

[node name="Dial" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Alpn" type="LineEdit" parent="Dial"]
custom_minimum_size = Vector2(200, 0)
layout_mode = 2
text = "gdiroh-example/shout/1"
tooltip_text = "the protocol's name — both ends must use the same one"

[node name="Target" type="LineEdit" parent="Dial"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "the other peer's ticket or id"

[node name="Connect" type="Button" parent="Dial"]
layout_mode = 2
disabled = true
text = "Link up"

[node name="Say" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Text" type="LineEdit" parent="Say"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "something to shout"

[node name="Send" type="Button" parent="Say"]
layout_mode = 2
disabled = true
text = "Shout"

[node name="Abort" type="Button" parent="Say"]
layout_mode = 2
disabled = true
tooltip_text = "hang up the conversation and tell the far side why, with a code"
text = "Hang up"

[node name="Log" parent="." instance=ExtResource("3_log")]
layout_mode = 2
size_flags_vertical = 3
