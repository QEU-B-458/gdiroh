[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://tabs/world_tab.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://common/copy_field.tscn" id="2_copy"]
[ext_resource type="PackedScene" path="res://common/log_panel.tscn" id="3_log"]

[node name="World" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 6
script = ExtResource("1_script")
slug = "world"

[node name="Blurb" type="Label" parent="."]
layout_mode = 2
text = "World state every peer can read and write. Same key from two peers? The later write wins."
autowrap_mode = 3

[node name="Lifecycle" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Start" type="Button" parent="Lifecycle"]
layout_mode = 2
text = "Start endpoint"

[node name="Stop" type="Button" parent="Lifecycle"]
layout_mode = 2
disabled = true
text = "Stop"

[node name="Random" type="CheckBox" parent="Lifecycle"]
layout_mode = 2
tooltip_text = "start with a throwaway id — for extra copies sharing user://, like the editor's multi-instance run"
text = "Random id"

[node name="Status" type="Label" parent="Lifecycle"]
layout_mode = 2
text = "stopped"

[node name="Id" parent="." instance=ExtResource("2_copy")]
layout_mode = 2

[node name="Ticket" parent="." instance=ExtResource("2_copy")]
layout_mode = 2

[node name="Open" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Create" type="Button" parent="Open"]
layout_mode = 2
disabled = true
text = "Create"

[node name="Ticket" type="LineEdit" parent="Open"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "doc ticket from the other peer"

[node name="Join" type="Button" parent="Open"]
layout_mode = 2
disabled = true
text = "Join"

[node name="Edit" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Key" type="LineEdit" parent="Edit"]
layout_mode = 2
placeholder_text = "key"

[node name="Value" type="LineEdit" parent="Edit"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "value"

[node name="Set" type="Button" parent="Edit"]
layout_mode = 2
disabled = true
text = "Set"

[node name="Read" type="Button" parent="Edit"]
layout_mode = 2
disabled = true
text = "Read"

[node name="Delete" type="Button" parent="Edit"]
layout_mode = 2
disabled = true
tooltip_text = "removes the key and everything under it"
text = "Delete"

[node name="Query" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Keys" type="Button" parent="Query"]
layout_mode = 2
disabled = true
text = "List keys"

[node name="Status" type="Button" parent="Query"]
layout_mode = 2
disabled = true
text = "Status"

[node name="Authors" type="Button" parent="Query"]
layout_mode = 2
disabled = true
tooltip_text = "every write is attributed to an author identity"
text = "Authors"

[node name="NewAuthor" type="Button" parent="Query"]
layout_mode = 2
disabled = true
text = "New author"

[node name="DocTicket" parent="." instance=ExtResource("2_copy")]
layout_mode = 2

[node name="Log" parent="." instance=ExtResource("3_log")]
layout_mode = 2
size_flags_vertical = 3
